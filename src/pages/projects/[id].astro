---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, date, tags, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <h1>{title}</h1>
  <ul class="meta">
    <li><time datetime={date.toISOString()}>{formatDate(date)}</time></li>
    {tags.map((tag) => <li>#{tag}</li>)}
  </ul>
  <p class="contacts">
    <span>[<a href={repo}>code</a>]</span>
    {demo && <span>[<a href={demo}>demo</a>]</span>}
  </p>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>
