---
import ExternalLink from '../components/ExternalLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="About" description={`About ${profile.name}.`}>
  <h1>About</h1>
  <div class="prose">
    {profile.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div class="contacts">
    {
      profile.contacts.map((contact) => (
        <span class="contact"><span class="label">{contact.label}</span><ExternalLink href={contact.href}>{contact.text}</ExternalLink></span>
      ))
    }
    {profile.cv && <span class="contact"><span class="label">CV</span><ExternalLink href={profile.cv}>Download PDF</ExternalLink></span>}
  </div>
</BaseLayout>
